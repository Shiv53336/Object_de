[Unit]
Description=TRADEMIND daily paper trading (Telegram login, then live paper run)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/opt/trademind/trademind
ExecStart=/opt/trademind/trademind/deploy/daily.sh
TimeoutStartSec=9h

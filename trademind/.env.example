# Copy to .env and fill in. .env is gitignored: never commit real values, never paste them in chat.
# The trademind CLI reads this file from the folder you run it in (override: TRADEMIND_ENV_FILE).

# --- Zerodha Kite Connect (needed for real data and paper trading) -------------------------------
# developers.kite.trade > your app. Redirect URL can be http://127.0.0.1 for a personal app.
KITE_API_KEY=
KITE_API_SECRET=

# --- Telegram (optional): trade alerts, daily summary, login link on your phone -----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Laptop run (no Docker): readable logs, SQLite journal in ./data -----------------------------
TRADEMIND_LOG_JSON=0
# TRADEMIND_DATA_DIR=data
# TRADEMIND_DATABASE_URL=sqlite:///data/journal.sqlite

# --- Server run (Docker Compose) only ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
TRADEMIND_API_TOKEN=change-me-to-a-long-random-string
